<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/overlay_expanded_background"
    android:elevation="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_assistant_idle"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <ImageView
            android:id="@+id/overlay_close_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Закрыть"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/overlay_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mic_ready"
        android:textSize="14sp"
        android:textColor="#BBFFFFFF"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- Mic Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <View
            android:id="@+id/mic_ripple"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/mic_ripple_background"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/overlay_mic_button"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_mic_off"
            android:contentDescription="@string/mic_ready"
            android:background="@drawable/mic_button_background"
            android:padding="16dp" />

    </FrameLayout>

    <!-- Hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Нажмите микрофон для голосовой команды. Дважды тапните по пузырьку для быстрого вызова."
        android:textSize="12sp"
        android:textColor="#88FFFFFF"
        android:gravity="center" />

</LinearLayout>