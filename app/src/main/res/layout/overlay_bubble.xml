<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Main bubble circle -->
    <ImageView
        android:id="@+id/bubble_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_assistant_idle"
        android:contentDescription="@string/overlay_bubble_collapsed"
        android:background="@drawable/bubble_background" />

    <!-- Label text (shown when expanded or on long press) -->
    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/overlay_bubble_collapsed"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:visibility="gone"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/text_bubble_background" />

</FrameLayout>